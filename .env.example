# --- HTTP server ---
PORT=3000
API_PREFIX=api
# Comma-separated list of allowed CORS origins (frontend dev server), or empty for '*'
CORS_ORIGINS=http://localhost:5173

# --- Ingress transport: true = mock (simulated feed, no hardware), false = ADSR-800 serial ---
USE_MOCK=true

# Serial (used when DATA_SOURCE=serial)
SERIAL_PORT=COM3
SERIAL_BAUD=460800

# Mock (used when USE_MOCK=true)
MOCK_AIRCRAFT=8
MOCK_TICK_MS=1000

# --- Receiver position (used as CPR local-decode reference) ---
RECEIVER_LAT=52
RECEIVER_LON=4

# --- Aircraft tracking ---
AIR_STALE_MS=15000
AIR_EVICT_MS=60000
AIR_SCAN_MS=10000

# --- Optional: ADSR-800 startup-banner config writes (within 5s window) ---
ADS_OUT_ENABLED=true
ADS_OUT_MODE=1
ADS_BAUD_OVERRIDE=