# ---------------------------------------------------------------------------
# Quick start (for new developers)
# ---------------------------------------------------------------------------
# 1. Copy this file:   cp .env.example .env        (Windows: copy .env.example .env)
# 2. Boot with real hardware attached:
#      npm run build && npm run start:prod
#    → API boots at http://localhost:3000 and ingests the attached receivers.
#      No simulated feeds exist: the process only ever shows real data.
#
# 3. Connect the real URM-02 Drone RID module:
#      The module streams JSON to UDP 65100 by default — no other settings needed.
#      (Optionally set RID_TRANSPORT — see the RID section below.)
#
# 4. Connect the real ADSR-800 receiver:
#      Plus one of:            TCP_HOST / TCP_PORT   (TCP serial bridge)
#                              SERIAL_PORT            (direct COM port)
#    See Ingress transport section below.
#
# 5. Connect the AIS receiver and choose AIS_TRANSPORT (serial/tcp/udp).
#
# 6. Confirm it's alive:
#      PowerShell: Invoke-RestMethod http://localhost:3000/api/health
#      curl:       curl http://localhost:3000/api/health
# ---------------------------------------------------------------------------

# --- HTTP server ---
PORT=3000
API_PREFIX=api
# Comma-separated list of allowed CORS origins (frontend dev server), or empty for '*'
CORS_ORIGINS=http://localhost:5173

# --- ADS-B ingress: TCP serial bridge first, else direct serial (ADSR-800) ---
TCP_HOST=192.168.0.7
TCP_PORT=8235
TCP_RECONNECT_MS=1000

# Real receiver directly on a COM port — used when TCP_PORT is 0/empty
SERIAL_PORT=COM3
SERIAL_BAUD=460800
# Optional ADSR-800 startup-banner config writes (within 5s of boot): plain-text
# commands sent right after the port opens, e.g. ensure ADS-B output is enabled.
# Comma-separated. Leave empty to send nothing.
SERIAL_INIT_COMMANDS=SetOutput=1

# --- Receiver position (used as CPR local-decode reference) ---
RECEIVER_LAT=52
RECEIVER_LON=4

# --- Aircraft tracking ---
AIR_STALE_MS=15000
AIR_EVICT_MS=60000
AIR_SCAN_MS=10000

# --- Drone Remote ID (URM-01/02) ---
# The physical module streams newline-delimited JSON over UDP (default IP
# 192.168.0.3, always sends to port 65100) AND over its USB Type-C serial
# bridge (CH340, typically COM5 @ 115200 baud).
# RID_TRANSPORT selects the capture path:
#   dual   = UDP 65100 + serial simultaneously (default, plug-and-play)
#   udp    = Ethernet only
#   serial = Type-C serial only
# The values below match the factory defaults and can stay as-is unless you
# changed the module's network settings.
RID_TRANSPORT=dual
RID_UDP_HOST=0.0.0.0
RID_UDP_PORT=65100
RID_SERIAL_PORT=COM5
RID_SERIAL_BAUD=115200
RID_STALE_MS=15000
RID_EVICT_MS=60000
RID_SCAN_MS=10000

# --- AIS Maritime (AERA Sentinel FST-1 VHF receiver) ---
# AIS_TRANSPORT selects how live NMEA sentences are captured:
#   serial (default)  AIS112E via USB-RS485 adapter (COM4 / 38400 8N1)
#   tcp               AIS112E behind a serial->Ethernet bridge
#   udp               AIS112E-A network/4G ground station pushing AIVDM to us
AIS_TRANSPORT=serial
AIS_SERIAL_PORT=COM4
AIS_SERIAL_BAUD=38400
AIS_UDP_HOST=0.0.0.0
AIS_UDP_PORT=65110
AIS_TCP_HOST=192.168.0.8
AIS_TCP_PORT=8236
AIS_TCP_RECONNECT_MS=1000
AIS_STALE_MS=300000
AIS_EVICT_MS=1800000
AIS_SCAN_MS=15000

# --- Optional: InfluxDB persistence (leave blank to disable) ---
# In production point ALL instances at ONE shared central InfluxDB
# (e.g. the Docker database from docker-compose.db.yml running on a server).
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=change-me-token
INFLUX_ORG=adsb
INFLUX_BUCKET=adsb