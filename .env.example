# ---------------------------------------------------------------------------
# Quick start (for new developers)
# ---------------------------------------------------------------------------
# 1. Copy this file:   cp .env.example .env        (Windows: copy .env.example .env)
# 2. Start simulated (no hardware):
#      npm run build && npm run start:prod
#    → API boots at http://localhost:3000 using mock feeds.
#
# 3. Connect the real URM-02 Drone RID module:
#      Add to your .env:       RID_USE_MOCK=false
#      Windows PowerShell:     $env:RID_USE_MOCK='false'; node dist/main.js
#      Linux/macOS:            RID_USE_MOCK=false node dist/main.js
#    The module streams JSON to UDP 65100 by default — no other settings needed.
#
# 4. Connect the real ADSR-800 receiver:
#      Add to your .env:       USE_MOCK=false
#      Plus one of:            TCP_HOST / TCP_PORT   (TCP serial bridge)
#                              SERIAL_PORT            (direct COM port)
#    See Ingress transport section below.
#
# 5. Confirm it's alive:
#      PowerShell: Invoke-RestMethod http://localhost:3000/api/health
#      curl:       curl http://localhost:3000/api/health
# ---------------------------------------------------------------------------

# --- HTTP server ---
PORT=3000
API_PREFIX=api
# Comma-separated list of allowed CORS origins (frontend dev server), or empty for '*'
CORS_ORIGINS=http://localhost:5173

# --- Ingress transport: true = mock (simulated feed, no hardware), false = real receiver ---
USE_MOCK=true

# Real receiver via TCP serial bridge (USR-TCP232-ED2) — used when USE_MOCK=false and TCP_PORT>0
TCP_HOST=192.168.0.7
TCP_PORT=8235
TCP_RECONNECT_MS=1000

# Real receiver directly on a COM port — used when USE_MOCK=false and no TCP_PORT
SERIAL_PORT=COM3
SERIAL_BAUD=460800
# Optional ADSR-800 startup-banner config writes (within 5s of boot): plain-text
# commands sent right after the port opens, e.g. ensure ADS-B output is enabled.
# Comma-separated. Leave empty to send nothing.
SERIAL_INIT_COMMANDS=SetOutput=1

# Mock (used when USE_MOCK=true)
MOCK_AIRCRAFT=8
MOCK_TICK_MS=1000

# --- Receiver position (used as CPR local-decode reference) ---
RECEIVER_LAT=52
RECEIVER_LON=4

# --- Aircraft tracking ---
AIR_STALE_MS=15000
AIR_EVICT_MS=60000
AIR_SCAN_MS=10000

# --- Drone Remote ID (URM-01/02) ---
# true = mock RID feed (no hardware), false = physical URM-02 via UDP
RID_USE_MOCK=true
RID_MOCK_DRONES=3
RID_MOCK_TICK_MS=1000

# Physical URM-02: the module streams newline-delimited JSON over UDP
# (default IP 192.168.0.3, always sends to port 65100).
# Set RID_USE_MOCK=false to activate. The values below match the factory defaults
# and can stay as-is unless you changed the module's network settings.
RID_UDP_HOST=0.0.0.0
RID_UDP_PORT=65100
RID_STALE_MS=15000
RID_EVICT_MS=60000
RID_SCAN_MS=10000

# --- Optional: TimescaleDB persistence (leave blank to disable) ---
# In production point ALL instances at ONE shared central TimescaleDB
# (e.g. the Docker database from docker-compose.db.yml running on a server).
DATABASE_URL=postgres://adsb:postgres@localhost:5432/adsb