# Copy to .env on the server before:  docker compose up -d
# The API continuously reads the receiver and saves to TimescaleDB.

# TimescaleDB credentials (used by both the DB and the API container)
POSTGRES_USER=adsb
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=adsb

# Receiver (ADSR-800) over the serial-to-Ethernet bridge
TCP_HOST=192.168.0.7
TCP_PORT=8235
USE_MOCK=false

# Receiver location (CPR local decode reference)
RECEIVER_LAT=52
RECEIVER_LON=4

# API port exposed to your users/browser
PORT=3000
