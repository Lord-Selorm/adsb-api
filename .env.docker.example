# Copy to .env on the server before:  docker compose up -d
# The API continuously reads the receivers and saves to InfluxDB.

# InfluxDB setup (used by both the DB init and the API container)
INFLUX_USERNAME=admin
INFLUX_PASSWORD=change-me-strong
INFLUX_ORG=adsb
INFLUX_BUCKET=adsb
INFLUX_TOKEN=change-me-a-long-random-token

# --- ADS-B receiver (ADSR-800) over the serial-to-Ethernet bridge ---
TCP_HOST=192.168.0.7
TCP_PORT=8235

# Receiver location (CPR local decode reference)
RECEIVER_LAT=52
RECEIVER_LON=4

# API port exposed to your users/browser
PORT=3000

# --- Drone Remote ID (URM-01/02) ---
# dual = UDP 65100 + USB serial simultaneously. On a Linux host the URM-02's
# CH340 usually enumerates as /dev/ttyUSB0 (docker-compose maps it via
# devices). RID_HOST_DEVICE overrides the host device name.
RID_TRANSPORT=dual
RID_UDP_PORT=65100
RID_SERIAL_PORT=/dev/ttyUSB0
RID_SERIAL_BAUD=115200
RID_HOST_DEVICE=/dev/ttyUSB0

# --- AIS Maritime (AERA Sentinel FST-1 VHF receiver) ---
# Transports: serial (default, AIS112E via USB-RS485), tcp (AIS112E bridge),
# or udp (AIS112E-A ground station pushing AIVDM to this host).
AIS_TRANSPORT=serial
AIS_SERIAL_PORT=/dev/ttyUSB1
AIS_SERIAL_BAUD=38400
AIS_HOST_DEVICE=/dev/ttyUSB1
AIS_UDP_PORT=65110
AIS_TCP_HOST=192.168.0.8
AIS_TCP_PORT=8236